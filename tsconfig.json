{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "newLine": "LF",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "utils/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "workspace", "storage"]
}
